[
  {"id": "deploy", "type": "deploy_env", "env_id": "zeroad", "ttl_seconds": 3600},
  {"id": "lobby", "type": "open_lobby", "env_id": "zeroad", "game_settings": {"size": 128, "seed": 7, "speed": 2.0, "time_cap_minutes": 8}, "depends_on": ["deploy"]},
  {"id": "slot-1", "type": "add_player_slot", "env_id": "zeroad", "player_id": "1", "player_kind": "ai", "game_settings": {"controller": "petra", "civ": "pers"}, "depends_on": ["lobby"]},
  {"id": "slot-2", "type": "add_player_slot", "env_id": "zeroad", "player_id": "2", "player_kind": "ai", "game_settings": {"controller": "petra", "civ": "cart"}, "depends_on": ["lobby"]},
  {"id": "close", "type": "close_lobby", "env_id": "zeroad", "depends_on": ["slot-1", "slot-2"]},
  {"id": "finish", "type": "finish_match", "env_id": "zeroad", "depends_on": ["close"]},
  {"id": "grade", "type": "grade_match", "env_id": "zeroad", "player_ids": ["1", "2"], "depends_on": ["finish"]},
  {"id": "files", "type": "save_match_files", "env_id": "zeroad", "depends_on": ["finish"]},
  {"id": "results", "type": "save_zeroad_results", "env_id": "zeroad", "depends_on": ["finish"]}
]
