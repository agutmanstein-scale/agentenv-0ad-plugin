+
+void Interface::WaitForMessage(std::chrono::milliseconds timeout)
+{
+	std::unique_lock<std::mutex> wakeLock(m_WakeLock);
+	m_Wake.wait_for(wakeLock, timeout, [this]() { return m_Posted.load(); });
+	m_Posted = false;
 }
 
