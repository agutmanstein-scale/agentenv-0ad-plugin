+void Interface::PacedUpdate(double realFrameLength)
+{
+	// No sim time is fed here: only a /step runs a turn. The view blends from the previous turn's state to the
+	// newest one over one turn length of real time, then holds at the end of the last turn.
+	const bool blending = m_PacedBlend < 1.f;
+	m_PacedBlend = std::min(1.f, m_PacedBlend + static_cast<float>(realFrameLength * 1000.0 / DEFAULT_TURN_LENGTH));
+	g_Game->GetSimulation2()->Interpolate(blending ? static_cast<float>(realFrameLength) : 0.f, m_PacedBlend,
+		static_cast<float>(realFrameLength));
+}
