+
+void Interface::PacedUpdate(double realFrameLength)
+{
+	if (!m_TurnPending)
+	{
+		// No /step is waiting: sim time stays put, but the view keeps interpolating (units hold at the end of the
+		// last turn, CTurnManager::Interpolate clamps its offset) and the camera and the director keep working.
+		g_Game->Interpolate(0.f, static_cast<float>(realFrameLength));
+		return;
+	}
+
+	const u32 turnBefore = g_Game->GetTurnManager()->GetCurrentTurn();
+	g_Game->Update(realFrameLength);
+	if (g_Game->GetTurnManager()->GetCurrentTurn() == turnBefore)
+		return;
+
+	// The one turn this /step allowed has run: answer it (the HTTP thread is waiting on m_MsgLock, held since the
+	// step was applied) and stop feeding sim time until the next /step.
+	m_TurnPending = false;
+	m_ReturnValue = m_WantState ? GetGameState() : std::string("{}");
+	m_MsgApplied.notify_one();
+	m_MsgLock.unlock();
+}
