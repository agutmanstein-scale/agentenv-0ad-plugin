# The stream tooling's settings. Copy to live/live.env (git-ignored) and fill it in; every laptop script in live/
# sources it (LIVE_ENV=/path/to/file names another). No secret goes here: the LiteLLM key and the RTMP server and key
# live in SSM Parameter Store (live/put-secret.sh).

# AWS: the profile is forced for every call when set (a shell's own AWS_PROFILE is then ignored). With
# LIVE_AWS_ACCOUNT set, every script that calls AWS first checks the credentials are that account's.
LIVE_AWS_PROFILE=
LIVE_AWS_ACCOUNT=
LIVE_AWS_REGION=us-west-2

# Where the box launches: subnets with a route to the internet (apt, PyPI, GitHub, the PPA, the model endpoint, the
# RTMP ingest), tried in turn because GPU capacity moves between zones; a security group with no inbound rule
# (everything goes through SSM); an instance profile whose role has AmazonSSMManagedInstanceCore and may read the
# SecureString parameters under LIVE_SSM_PREFIX (default aws/ssm key).
LIVE_SUBNETS=
LIVE_SECURITY_GROUP=
LIVE_INSTANCE_PROFILE=
# Instance types, in order: g6.4xlarge is one NVIDIA L4, 16 vCPU, 64 GB (about $1.32/h on demand in us-west-2).
LIVE_GPU_TYPES="g6.4xlarge gr6.4xlarge"
LIVE_BOX_USD_PER_HOUR=1.32
# The box powers itself off (and so terminates) this many hours after launch.
LIVE_MAX_HOURS=12
LIVE_BOX_NAME=zeroad-live-onair
# teardown.sh and stop-box.sh act only on a box with this purpose tag and LIVE_BOX_NAME as its Name.
LIVE_TAG_PURPOSE=zeroad-live
LIVE_TAG_OWNER=

# Transfers: the code and results go through this bucket (in LIVE_AWS_REGION) with presigned URLs, so the box needs
# no S3 rights.
LIVE_BUCKET=
LIVE_S3_PREFIX=zeroad-live

# Images: build them on the box from this checkout (about 30 min, the patched engine is most of it), or pull
# mcp-server-zeroad-live from a registry the box can reach (LIVE_IMAGE_REGISTRY, e.g. an ECR repository URI prefix).
LIVE_IMAGES=build
LIVE_IMAGE_REGISTRY=
LIVE_IMAGE_TAG=latest

# Secrets: SecureString parameters, stored with live/put-secret.sh: $LIVE_SSM_PREFIX/litellm-key,
# $LIVE_SSM_PREFIX/rtmp-server (e.g. X Media Studio's rtmps://<region>.pscp.tv:443/x) and $LIVE_SSM_PREFIX/rtmp-key.
LIVE_SSM_PREFIX=/zeroad-live
# The model endpoint (not secret): LiteLLM's OpenAI-compatible base URL.
LIVE_LITELLM_BASE_URL=https://litellm.example.com

# Budget guard. A match starts only if the box ledger's model spend + this match's caps + the box's hours so far and
# the match's hours at LIVE_BOX_USD_PER_HOUR fit LIVE_BUDGET_USD, and a model match's caps fit LIVE_MATCH_CAP_USD
# ($9 for the 40-minute livestream: two strategists at $4, two Luna reflexes at $0.50).
LIVE_BUDGET_USD=
LIVE_MATCH_CAP_USD=9
# Below this much free disk the box deletes its oldest recording segment.
LIVE_MIN_FREE_GB=8
