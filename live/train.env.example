# Settings for a post-training run box. Copy to live/train.env (git-ignored, like live/pilot.env) and fill it in, then
# run every training script with it: LIVE_ENV=live/train.env live/launch.sh ... No secret goes here.
# The AWS and network settings are live.env.example's; only what differs for a training box is explained below.

LIVE_AWS_PROFILE=
LIVE_AWS_ACCOUNT=
LIVE_AWS_REGION=us-west-2
LIVE_SUBNETS=
LIVE_SECURITY_GROUP=
LIVE_INSTANCE_PROFILE=
LIVE_TAG_OWNER=
LIVE_TAG_PURPOSE=zeroad-train
LIVE_BOX_NAME=zeroad-train

# Four 48 GB L40S GPUs: two serve (vLLM, TP=1 each), two train. A g6e.12xlarge is $10.49/h on demand in us-west-2, a
# g6e.24xlarge $15.07/h (both verified against AWS on-demand pricing). There is no default rate for a training box (the
# stream box's $1.32/h once priced a run at an eighth of its cost): LIVE_REQUIRE_RATE makes every script refuse to run
# without LIVE_BOX_USD_PER_HOUR (the first type's), and every fallback type needs its own rate in LIVE_GPU_RATES or
# launch.sh refuses to start. launch.sh tags the launched type's rate on the box and bootstrap.sh writes that one to the
# box's config, so a launch that fell back to the g6e.24xlarge is priced at 15.07; the run config's box_usd_per_hour must
# match the box's rate (train.sh start checks it).
LIVE_GPU_TYPES="g6e.12xlarge g6e.24xlarge"
LIVE_GPU_RATES="g6e.12xlarge=10.49 g6e.24xlarge=15.07"
LIVE_REQUIRE_RATE=1
LIVE_BOX_USD_PER_HOUR=10.49

# The run's length plus 2 hours: the box powers itself off then, and a run must have finished its last panel and its
# final upload first. The deadline is counted from the launch, on every boot (a stopped and started box keeps it), so
# the bootstrap's hour comes out of the two. The power-off only stops the box (the disk stays, and so do the games, until the final upload is
# checked and the box is terminated by hand), where the stream box's power-off terminates it and deletes its volume.
LIVE_MAX_HOURS=12
LIVE_SHUTDOWN_BEHAVIOR=stop

# The stage budget in dollars (box hours at the rate above plus the frontier models' spend). The run's own budget_usd
# in its config is the one that stops the run; this one refuses a start that would pass it, counting the run's whole
# duration_hours at the rate on top of what the box ledger already holds. LIVE_MATCH_CAP_USD caps each frontier seat's
# spend in one game.
LIVE_BUDGET_USD=
LIVE_MATCH_CAP_USD=9

# Code and results go through this bucket. The orchestrator copies the run to s3://LIVE_BUCKET/LIVE_S3_PREFIX/run/<id>
# with the box's instance role: make it with live/train-iam.sh (the run config's s3.uri says where).
LIVE_BUCKET=
LIVE_S3_PREFIX=zeroad-train

LIVE_IMAGES=build
LIVE_IMAGE_REGISTRY=
LIVE_IMAGE_TAG=latest

# Secrets stay in SSM: the LiteLLM key (frontier panels) is $LIVE_SSM_PREFIX/litellm-key (live/put-secret.sh).
LIVE_SSM_PREFIX=/zeroad-live
LIVE_LITELLM_BASE_URL=https://litellm.example.com
LIVE_LITELLM_ALT_BASE_URL=
LIVE_MIN_FREE_GB=8
