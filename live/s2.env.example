# Settings for box day 1 and Run 1 (docs/s2-box-day.md): one g6e.12xlarge, unattended for about 18 hours. Copy to
# live/s2.env (git-ignored, like live/train.env) and fill it in, then run every S2 script with it:
#   LIVE_ENV=live/s2.env live/launch.sh ... ; LIVE_ENV=live/s2.env live/s2.sh ID start live/s2
# No secret goes here. This is train.env.example with the numbers of the whole sequence; only what differs is explained.

LIVE_AWS_PROFILE=
LIVE_AWS_ACCOUNT=
LIVE_AWS_REGION=us-west-2
LIVE_SUBNETS=
LIVE_SECURITY_GROUP=
LIVE_INSTANCE_PROFILE=
LIVE_TAG_OWNER=
LIVE_TAG_PURPOSE=zeroad-s2
LIVE_BOX_NAME=zeroad-s2

# Four 48 GB L40S GPUs: two serve (vLLM, TP=1 each), two train. A g6e.12xlarge is $10.49/h on demand in us-west-2, a
# g6e.24xlarge $15.07/h (both verified against AWS on-demand pricing). There is no default rate: LIVE_REQUIRE_RATE makes
# every script refuse to run without LIVE_BOX_USD_PER_HOUR (the first type's), and every fallback type needs its own rate
# in LIVE_GPU_RATES or launch.sh refuses to start. launch.sh tags the launched type's rate on the box and bootstrap.sh
# writes that one to the box's config; the step configs' box_usd_per_hour (live/s2/*.toml) must match it, and
# s2.sh start checks that on the box.
LIVE_GPU_TYPES="g6e.12xlarge g6e.24xlarge"
LIVE_GPU_RATES="g6e.12xlarge=10.49 g6e.24xlarge=15.07"
LIVE_REQUIRE_RATE=1
LIVE_BOX_USD_PER_HOUR=10.49

# The box powers itself off this many hours after launch, counted from the launch on every boot. The sequence is about
# 18.3 hours (live/s2/sequence.toml's expected_hours: E1 0.5, E2 2.3, baselines 2.6, labels 0.4, SFT 0.8, SFT panels 1.4,
# Run 1 10.3) and the bootstrap is about an hour before it starts; the rest is margin. s2.sh start refuses a box whose
# deadline leaves less than the expected hours plus half an hour. The power-off only stops the box (the disk stays, and
# so do the games until the final upload is checked and the box is terminated by hand).
LIVE_MAX_HOURS=21
LIVE_SHUTDOWN_BEHAVIOR=stop

# The stage budget in dollars: the box's hours at the rate above (the box's own, bootstrap included: about 19.3 h, $202)
# plus the frontier models' spend (baseline panel about $26, teacher calibration about $15, labels about $63, end panel
# about $26: $130). That is about $332 if every step takes its expected time; $350 leaves room for the steps' normal
# spread, and a smaller number would refuse Run 1 at its start, after most of the money was spent. s2.sh start refuses
# a sequence whose expected hours at the rate, on top of what the box ledger already holds, would pass it, and the
# sequence asks the guard again before every step (its cap in hours, and the step's frontier spend caps in dollars).
# Every step config's budget_usd is this number. LIVE_MATCH_CAP_USD caps each frontier seat's spend in one game.
LIVE_BUDGET_USD=350
LIVE_MATCH_CAP_USD=9

# Code and results go through this bucket. Each step's orchestrator copies its root to s3://LIVE_BUCKET/<the config's
# s3.uri path> with the box's instance role (live/train-iam.sh makes it for LIVE_S3_PREFIX/run/*, which is where the
# configs of live/s2 write: s3://BUCKET/zeroad-train/run/s2-*). live/s2.sh replaces the BUCKET in them with this.
LIVE_BUCKET=
LIVE_S3_PREFIX=zeroad-train

LIVE_IMAGES=build
LIVE_IMAGE_REGISTRY=
LIVE_IMAGE_TAG=latest

# Secrets stay in SSM: the LiteLLM key (frontier panels, the teacher's labels) is $LIVE_SSM_PREFIX/litellm-key
# (live/put-secret.sh litellm-key).
LIVE_SSM_PREFIX=/zeroad-live
LIVE_LITELLM_BASE_URL=https://litellm.example.com
LIVE_LITELLM_ALT_BASE_URL=
LIVE_MIN_FREE_GB=8
