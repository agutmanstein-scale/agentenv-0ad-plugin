# Settings for the showcase box (docs/superpowers/specs/2026-11-19-showcase-stream-design.md, "The box"): one g6e.2xlarge
# (one 48 GB L40S) that stays up for the spike, the test game, the rehearsal and the session. Copy to live/showcase.env
# (git-ignored with the other *.env) and run every showcase script with it:
#   LIVE_ENV=live/showcase.env live/launch.sh ... ; LIVE_ENV=live/showcase.env live/bootstrap.sh ID --showcase
# The site settings (account, subnets, security group, bucket, SSM prefix, LiteLLM URL) are live.env's; only what the
# showcase box changes is set here. No secret goes here.
_showcase_env_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$_showcase_env_dir/live.env" ]; then
  # shellcheck source=/dev/null
  source "$_showcase_env_dir/live.env"
else
  # shellcheck source=live.env.example
  source "$_showcase_env_dir/live.env.example"
fi

# A g6e.2xlarge is $2.24/h on demand. Every script refuses to run without the rate of the type it launched.
LIVE_GPU_TYPES="g6e.2xlarge"
LIVE_GPU_RATES="g6e.2xlarge=2.24"
LIVE_REQUIRE_RATE=1
LIVE_BOX_USD_PER_HOUR=2.24
LIVE_TAG_PURPOSE=zeroad-showcase
LIVE_BOX_NAME=zeroad-showcase

# The power-off deadline counted from launch, and the budget guard's cap for every stage together (box hours at the rate
# above, plus the frontier models' spend). The box stops, not terminates, so it persists between stages.
LIVE_MAX_HOURS=10
LIVE_BUDGET_USD=60
LIVE_SHUTDOWN_BEHAVIOR=stop

# The box uses the training box's instance profile: S3 read of Run 1's adapter and write of the session's upload under
# zeroad-train/run/, and the SSM reads (live/train-iam.sh made it). It must exist when the box is launched.
LIVE_INSTANCE_PROFILE=zeroad-train-box

# Run 1's adapter is read from s3://LIVE_BUCKET/LIVE_S3_PREFIX/run/s2-run1/adapters/v50/ and the session is uploaded under
# LIVE_S3_PREFIX/run/showcase-<stamp>/: the prefix s2.env uses, which the instance profile above covers.
LIVE_S3_PREFIX=zeroad-train
