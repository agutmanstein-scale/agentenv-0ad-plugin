# Settings for the S1 tool-check box (docs/s1-tool-check.md): a CPU box, no GPU. Copy to live/s1.env (git-ignored, like
# live/pilot.env and live/train.env) and fill it in, then run every S1 script with it:
#   LIVE_ENV=live/s1.env live/launch.sh ... ; LIVE_ENV=live/s1.env live/s1.sh ID start ...
# No secret goes here. The AWS and network settings are live.env.example's; only what differs is explained below.

LIVE_AWS_PROFILE=
LIVE_AWS_ACCOUNT=
LIVE_AWS_REGION=us-west-2
LIVE_SUBNETS=
LIVE_SECURITY_GROUP=
LIVE_INSTANCE_PROFILE=
LIVE_TAG_OWNER=
LIVE_TAG_PURPOSE=zeroad-s1
LIVE_BOX_NAME=zeroad-s1

# CPU types, 48 vCPUs each, in the order launch.sh tries them. launch.sh's variable is named for the GPU boxes it was
# written for (LIVE_GPU_TYPES, LIVE_GPU_RATES); it takes any instance type, so it is reused here, not renamed. On-demand
# rates in us-west-2, verified against AWS pricing: c7i.12xlarge $2.142/h, c6a.12xlarge $1.836/h, c7a.12xlarge $2.463/h.
# There is no default rate (LIVE_REQUIRE_RATE=1): every type needs its own here, the launched type's rate is tagged on
# the box and bootstrap.sh writes it to the box's config, so a launch that fell back to the c7a is priced at 2.463.
LIVE_GPU_TYPES="c7i.12xlarge c6a.12xlarge c7a.12xlarge"
LIVE_GPU_RATES="c7i.12xlarge=2.142 c6a.12xlarge=1.836 c7a.12xlarge=2.463"
LIVE_REQUIRE_RATE=1
LIVE_BOX_USD_PER_HOUR=2.142

# A plain Ubuntu 24.04 x86_64 AMI, from Canonical's public SSM parameter, instead of the GPU boxes' Deep Learning AMI.
# bootstrap.sh --cpu installs Docker and uv on it.
LIVE_AMI_SSM_PARAM=/aws/service/canonical/ubuntu/server/24.04/stable/current/amd64/hvm/ebs-gp3/ami-id

# The box powers itself off this many hours after launch: bootstrap (about 25 min with the image built), the batch
# (LIVE_S1_WALL_HOURS) and the fetch have to fit. It only stops (the disk stays, billed as storage, about $0.50 a
# day for 200 GB) rather than terminates: if the power-off comes before the results are fetched they are still on the
# disk, and `aws ec2 start-instances` brings the box back. live/teardown.sh terminates it once they are fetched.
LIVE_MAX_HOURS=4
LIVE_SHUTDOWN_BEHAVIOR=stop

# The stage budget in dollars: box hours at the rate above (no model spend: no game has an LLM seat). s1.sh start
# refuses a batch whose wall-clock limit at the rate, on top of the hours already run, would pass it. The expected cost
# is 3 to 4 hours at $2.142/h, about $7 to $9.
LIVE_BUDGET_USD=15

# Code and results go through this bucket (presigned, so the box needs no S3 rights): the S1 inputs go up and the
# fetched results come down through it.
LIVE_BUCKET=
LIVE_S3_PREFIX=zeroad-s1

# --images build builds zeroad-engine:0.28 on the box (about 10 min); --images pull takes zeroad-engine:LIVE_IMAGE_TAG
# from LIVE_IMAGE_REGISTRY, which must hold that image (nothing pushes one by default).
LIVE_IMAGES=build
LIVE_IMAGE_REGISTRY=
LIVE_IMAGE_TAG=latest

# The batch (live/s1.sh start):
#   LIVE_S1_PER_CELL     bot games per interface (v1, v2) and Petra level (1, 2, 3): 100 gives 600 bot games
#   LIVE_S1_REPLAYS      pilot games to replay under v1 and v2: 40 gives 80 replay games
#   LIVE_S1_PILOT_RESULTS  the pilot's fetched results, where the replays are picked from (relative to the repo)
#   LIVE_S1_WALL_HOURS   the whole batch's wall-clock limit, calibration included; it must leave LIVE_MAX_HOURS at least
#                        an hour more for the bootstrap and the fetch
#   LIVE_S1_ENGINES      engines in the pool; empty is the box's vCPUs minus 4
LIVE_S1_PER_CELL=100
LIVE_S1_REPLAYS=40
LIVE_S1_PILOT_RESULTS=live/fetched/pilot-final
LIVE_S1_WALL_HOURS=2.5
LIVE_S1_ENGINES=

LIVE_SSM_PREFIX=/zeroad-live
LIVE_MIN_FREE_GB=8
